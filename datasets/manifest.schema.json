{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Restore Validation Dataset Manifest",
  "type": "object",
  "required": ["dataset", "retrieved_at_utc", "items"],
  "properties": {
    "dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "retrieved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "source_page_url",
          "asset_url",
          "license",
          "license_url",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(png|jpg|jpeg)$"
          },
          "source_page_url": {
            "type": "string",
            "format": "uri"
          },
          "asset_url": {
            "type": "string",
            "format": "uri"
          },
          "creator": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
